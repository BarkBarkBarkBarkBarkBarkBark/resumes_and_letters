+def test_explicit_project_selection_excludes_and_orders(resume_data):
+    names = [project["name"] for project in resume_data["projects"]]
+    selected = [names[-1], names[0]]
+    filtered = apply_profile(resume_data, {"project_names": selected})
+    assert [project["name"] for project in filtered["projects"]] == selected
+    assert len(resume_data["projects"]) == len(names)
+
+
+def test_empty_project_selection_hides_projects(resume_data):
+    assert apply_profile(resume_data, {"project_names": []})["projects"] == []
+
+
+def test_volunteer_selection_preserves_relevant_organization(resume_data):
+    selected = resume_data["volunteer"][0]["organization"]
+    filtered = apply_profile(resume_data, {"volunteer_organizations": [selected]})
+    assert [entry["organization"] for entry in filtered["volunteer"]] == [selected]
+    assert len(resume_data["volunteer"]) > 1
+
+
+def test_research_has_its_own_bullet_budget(resume_data):
