{% import 'figures.html.j2' as figures %}
{% macro evidence(item) -%}
{% if item.evidence %}<a class="evidence" href="{{ item.evidence }}" aria-label="Source evidence: {{ item.text }}"><img src="assets/github.png" alt="" width="16" height="16"></a>{% endif %}
{%- endmacro %}
{% macro entry(job) -%}
<article class="entry">
  <h3>{{ job.role }} <span class="organization">— {{ job.organization }}</span></h3>
  <p class="meta">{{ job.start_date | fmt_date }} – {{ job.end_date | fmt_date }}{% if job.location %} · {{ job.location }}{% endif %}</p>
  <ul>{% for bullet in job.bullets %}<li>{{ bullet.text }} {{ evidence(bullet) }}</li>{% endfor %}</ul>
  {% for key in job.evidence_ids | default([]) %}<p class="meta"><a href="evidence.html#{{ key }}">Methods &amp; publication boundary</a></p>{% endfor %}
</article>
{%- endmacro %}
{% macro project_card(project, featured=false) -%}
<article class="project{% if featured %} featured{% endif %}" id="{{ project.id }}">
  <p class="maturity">{{ project.maturity }}</p>
  <h3>{{ project.name }}</h3>
  {% if project.headline_result %}<p class="result-key">{{ project.headline_result }}</p>{% endif %}
  <p class="project-purpose">{{ project.problem }}</p>
  {% for key in project.evidence_ids | default([]) %}
  {% set record = resume.evidence_records[key] %}
  {% if record.visual and not record.visual.secondary %}
  {{ figures.figure(record) }}
  {% endif %}
  {% endfor %}
  {% if featured %}
  <dl class="project-facts">
    <dt>Technical approach</dt><dd>{{ project.bullets[0].text }} {{ evidence(project.bullets[0]) }}</dd>
    <dt>Evaluation scope</dt><dd>{{ project.tested }}</dd>
    <dt>Finding / implementation</dt><dd>{{ project.bullets[1].text }} {{ evidence(project.bullets[1]) }}</dd>
  </dl>
  {% else %}
  <ul>{% for bullet in project.bullets %}<li>{{ bullet.text }} {{ evidence(bullet) }}</li>{% endfor %}</ul>
  {% endif %}
  <p class="status">{{ project.status }}</p>
  <p class="evidence-label">Evidence</p>
  <div class="project-links">
    {% for link in project.links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
    {% if project.evidence_ids %}<a href="evidence.html#{{ project.evidence_ids[0] }}">Methods &amp; limitations</a>{% endif %}
  </div>
</article>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ resume.personal.name }} — {{ resume.personal.headline }}</title>
  <meta name="description" content="{{ resume.site.intro_blurb | trim }}">
  <style>
    :root { color-scheme: light; --ink:#182833; --muted:#4b5d68; --accent:#14546b; --rule:#ccd8db; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; scroll-padding-top:1rem; }
    body { margin:0; background:#f1f4f3; color:var(--ink); font:16px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif; }
    a { color:var(--accent); text-underline-offset:.2em; overflow-wrap:anywhere; }
    a:hover { text-decoration-thickness:2px; }
    a:focus-visible { outline:3px solid #9b4d16; outline-offset:4px; border-radius:2px; }
    .skip-link { position:absolute; top:-5rem; left:1rem; background:white; padding:.5rem; }
    .skip-link:focus { top:1rem; }
    .sheet { max-width:1240px; margin:2.5rem auto; background:#fff; border:1px solid var(--rule); padding:2.5rem; }
    .eyebrow { font-size:.85rem; font-weight:650; color:var(--muted); letter-spacing:.06em; text-transform:uppercase; margin:0 0 .5rem; }
    h1 { margin:0 0 .65rem; font-size:clamp(1.85rem,4vw,3rem); letter-spacing:-.035em; line-height:1.18; }
    h2 { font-size:1.4rem; line-height:1.3; margin:0 0 1.2rem; padding-bottom:.5rem; border-bottom:1px solid var(--rule); }
    h3 { font-size:1.06rem; line-height:1.4; margin:0 0 .35rem; }
    p { margin:0 0 .8rem; }
    .intro { max-width:75ch; font-size:1.05rem; }
    .supporting-line { font-weight:600; color:var(--accent); margin-bottom:.8rem; }
    .print-only { display:none; }
    .actions { display:flex; flex-wrap:wrap; gap:.65rem; margin:1.5rem 0; }
    .actions a { display:inline-flex; min-height:44px; align-items:center; padding:.55rem 1rem; border:1px solid var(--accent); border-radius:4px; text-decoration:none; font-weight:650; }
    .actions a:first-child { background:var(--accent); color:white; }
    .profiles { display:flex; flex-wrap:wrap; gap:.35rem 1.2rem; font-size:.88rem; }
    .profiles a { display:flex; align-items:baseline; gap:.5rem; width:fit-content; max-width:100%; }
    .profiles img { width:19px; height:19px; object-fit:contain; align-self:center; flex-shrink:0; }
    .profiles span { min-width:0; overflow-wrap:anywhere; }
    section { margin-top:2.6rem; }
    .project-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
    .project { padding:1.25rem; border:1px solid var(--rule); border-radius:6px; break-inside:avoid; }
    .supporting-projects { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
    .maturity { display:inline-block; margin:0 0 .65rem; padding:.15rem .55rem; background:#e7f1ed; color:#18503c; font-size:.75rem; font-weight:750; letter-spacing:.05em; text-transform:uppercase; }
    .project h3 { font-size:1.18rem; }
    .project-purpose { font-size:.9rem; color:var(--muted); }
    .result-key { font-size:.95rem; font-weight:750; color:var(--accent); line-height:1.5; margin:.65rem 0; }
    .project-facts { font-size:.9rem; }
    .project-facts dt, .evidence-label { font-size:.77rem; text-transform:uppercase; letter-spacing:.04em; font-weight:750; margin:1rem 0 .2rem; }
    .project-facts dd { margin:0; }
    {{ figures.styles() }}
    .status { font-size:.9rem; color:var(--muted); }
    .project-links { display:flex; flex-wrap:wrap; gap:.4rem 1.2rem; font-size:.9rem; }
    ul { margin:.5rem 0 .8rem; padding-left:1.3rem; }
    li { padding-left:.15rem; margin:.25rem 0; }
    .evidence { display:inline-flex; vertical-align:middle; padding:3px; margin-left:2px; line-height:1; }
    .evidence img { object-fit:contain; }
    .entry { margin:0 0 1.25rem; break-inside:avoid; }
    .organization { font-weight:450; }
    .meta { font-size:.88rem; color:var(--muted); margin:0 0 .4rem; }
    .cv-section { margin-top:1.8rem; }
    .skills { display:grid; grid-template-columns:1fr 1fr; gap:.5rem 1.8rem; }
    .skills h3 { font-size:1rem; }
    footer { font-size:.8rem; color:var(--muted); margin-top:2rem; border-top:1px solid var(--rule); padding-top:1rem; }
    @media (max-width:960px) {
      .project-grid, .supporting-projects { grid-template-columns:1fr; }
    }
    @media (max-width:640px) {
      .sheet { margin:0; border:0; padding:1.7rem 1.2rem; }
      h1 { font-size:1.85rem; }
      .skills { grid-template-columns:1fr; }
      .actions a { flex-grow:1; justify-content:center; }
    }
    @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
    @page { size:letter; margin:.7in; }
    @media print {
      body { background:white; font:11pt/13pt "Times New Roman",Times,serif; }
      .sheet { border:0; margin:0; padding:0; max-width:none; }
      .screen-only, .skip-link, footer { display:none !important; }
      .print-only { display:block; }
      h1 { font-size:22pt; }
      h1 { margin:0 0 6pt; }
      h2 { font-size:12pt; margin:0 0 5pt; padding:0 0 3pt; break-after:avoid; }
      h3, .project h3 { font-size:11pt; margin:0 0 3pt; break-after:avoid; }
      p { margin:0 0 4pt; }
      section, .cv-section { margin-top:9pt; }
      .project { padding:6pt 0; border:0; }
      .project-grid, .supporting-projects { display:block; }
      .project-visual { display:none; }
      .entry { margin-bottom:7pt; }
      ul { margin:3pt 0 5pt; }
      li { margin:2pt 0; }
      .status, .project-links, .meta { font-size:10pt; }
      .project-links { gap:0 10pt; }
      .evidence { padding:0; }
      .evidence img { width:10pt; height:10pt; }
      a { color:inherit; }
      .profiles { font-size:10pt; }
      .skills { display:block; }
      .skills > div { break-inside:avoid; }
      .skills h3 { font-size:11pt; }
    }
  </style>
</head>
<body>
<a class="skip-link" href="#selected-projects">Skip to selected projects</a>
<main class="sheet">
  {% set c = resume.personal.contact %}
  <header>
    <p class="eyebrow screen-only">{{ resume.personal.name }}</p>
    <h1 class="screen-only">{{ resume.personal.headline }}</h1>
    <h1 class="print-only">{{ resume.personal.name }}</h1>
    <p class="supporting-line">{{ resume.personal.supporting_line }}</p>
    <p class="intro screen-only">{{ resume.site.intro_blurb | trim }}</p>
    <nav class="actions screen-only" aria-label="Primary actions">
      <a href="{{ engineering_pdf_url | default('marco_del_fava_engineering.pdf') }}" download>Engineering Resume · 1 page</a>
      <a href="{{ pdf_url }}" download>Full Research CV (PDF)</a>
      <a href="#selected-projects">Engineering Projects</a>
      <a href="mailto:{{ c.email }}">Email</a>
    </nav>
    <div class="profiles">
      {% if c.github %}<a href="{{ c.github }}"><img src="assets/github.png" alt="GitHub" width="19" height="19"><span>{{ c.github }}</span></a>{% endif %}
      {% if c.linkedin %}<a href="{{ c.linkedin }}"><img src="assets/linkedin.png" alt="LinkedIn" width="19" height="19"><span>{{ c.linkedin }}</span></a>{% endif %}
    </div>
  </header>

  <section class="print-only" aria-labelledby="profile-title">
    <h2 id="profile-title">Research Profile</h2>
    <p>{{ resume.summary_text | trim }}</p>
    <p class="meta">{{ c.location }} · <a href="mailto:{{ c.email }}">{{ c.email }}</a>{% if c.phone %} · {{ c.phone }}{% endif %}</p>
  </section>

  <section id="selected-projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Selected Engineering Projects</h2>
    <div class="project-grid">
      {% for project in resume.projects[:3] %}{{ project_card(project, project.tested is defined) }}{% endfor %}
    </div>
  </section>

  {% for job in resume.research if job.case_study %}
  <section aria-labelledby="narrative-title">
    <h2 id="narrative-title">Human Single-Neuron Research</h2>
    {{ project_card(job.case_study, true) }}
  </section>
  {% endfor %}

  <section aria-labelledby="skills-title">
    <h2 id="skills-title">Technical Skills</h2>
    <div class="skills">
    {% for group in resume.skills %}
    <div><h3>{{ group.category }}</h3>
      <ul>{% for item in group['items'] %}<li>{{ item.text }} {{ evidence(item) }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
    </div>
  </section>

  {% if resume.research %}
  <section aria-labelledby="research-title">
    <h2 id="research-title">Research Experience</h2>
    {% for job in resume.research %}{{ entry(job) }}{% endfor %}
  </section>
  {% endif %}

  {% if resume.projects | length > 3 %}
  <section aria-labelledby="supporting-title">
    <h2 id="supporting-title">Supporting Software &amp; Prototypes</h2>
    <div class="supporting-projects">
      {% for project in resume.projects[3:] %}{{ project_card(project) }}{% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="education" aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    {% for edu in resume.education %}
    <article class="entry">
      <h3>{{ edu.degree }}</h3>
      <p>{{ edu.institution }} · {{ edu.graduation_date }}</p>
      {% if edu.notes %}<p>{{ edu.notes }}</p>{% endif %}
    </article>
    {% endfor %}
  </section>

  <section aria-labelledby="professional-title">
    <h2 id="professional-title">Additional Professional Experience</h2>
    {% for job in resume.experience + resume.volunteer %}{{ entry(job) }}{% endfor %}
  </section>

  {% if resume.certifications %}
  <section aria-labelledby="certifications-title">
    <h2 id="certifications-title">Certifications</h2>
    <ul>{% for cert in resume.certifications %}<li>{% if cert.credly_url %}<a href="{{ cert.credly_url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %} — {{ cert.issuer }}{% if cert.date %} ({{ cert.date | fmt_date }}){% endif %}</li>{% endfor %}</ul>
  </section>
  {% endif %}
  <footer>Portfolio and CV generated from the same canonical content.{% if source_commit %} Source revision: {{ source_commit }}.{% endif %}</footer>
</main>
</body>
</html>
