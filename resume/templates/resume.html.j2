{% macro entry(job) -%}
<article class="entry">
  <h3>{{ job.role }} <span>— {{ job.organization }}</span></h3>
  <p class="meta">{{ job.start_date | fmt_date }} – {{ job.end_date | fmt_date }}{% if job.location %} · {{ job.location }}{% endif %}</p>
  <ul>{% for bullet in job.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul>
</article>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ resume.personal.name }} — {{ resume.personal.headline }}</title>
  <meta name="description" content="{{ resume.site.intro_blurb | trim }}">
  <style>
    :root { color-scheme:light; --ink:#202b32; --muted:#52616a; --accent:#17576b; --rule:#dce2e4; }
    * { box-sizing:border-box; }
    body { margin:0; background:white; color:var(--ink); font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif; }
    main { max-width:860px; margin:0 auto; padding:3rem 1.5rem; }
    a { color:var(--accent); text-underline-offset:.2em; overflow-wrap:anywhere; }
    a:hover { text-decoration-thickness:2px; }
    a:focus-visible { outline:3px solid #9b4d16; outline-offset:4px; }
    .skip-link { position:absolute; top:-5rem; left:1rem; background:white; padding:.5rem; }
    .skip-link:focus { top:1rem; }
    h1 { font-size:2rem; line-height:1.2; letter-spacing:-.025em; margin:0 0 .35rem; }
    h2 { font-size:1.25rem; line-height:1.3; margin:0 0 1.2rem; padding-bottom:.5rem; border-bottom:1px solid var(--rule); }
    h3 { font-size:1.05rem; line-height:1.4; margin:0 0 .35rem; }
    p { margin:0 0 .7rem; }
    .identity { display:flex; align-items:flex-start; gap:1rem; margin-bottom:1rem; }
    .badge { display:block; width:52px; flex-shrink:0; }
    .badge img { display:block; width:100%; height:auto; }
    .focus { font-weight:600; margin-bottom:.2rem; }
    .meta { color:var(--muted); font-size:.88rem; }
    nav { display:flex; flex-wrap:wrap; gap:.4rem 1.2rem; margin-top:1rem; }
    nav a { padding:.3rem 0; }
    section { margin-top:2.4rem; }
    .project, .entry { margin-bottom:1.6rem; }
    .project:last-child, .entry:last-child { margin-bottom:0; }
    .project .meta { margin-top:.6rem; }
    .entry h3 span { font-weight:400; }
    ul { margin:.4rem 0 .7rem; padding-left:1.25rem; }
    li { margin:.2rem 0; }
    .skills p { margin-bottom:.65rem; }
    footer { margin-top:2rem; padding-top:1rem; border-top:1px solid var(--rule); font-size:.8rem; color:var(--muted); }
    @media (max-width:600px) {
      main { padding:1.8rem 1.15rem; }
      h1 { font-size:1.75rem; }
      .identity { gap:.75rem; }
      .badge { width:40px; }
      section { margin-top:2rem; }
    }
    @page { size:letter; margin:.7in; }
    @media print {
      body { font:11pt/1.35 "Times New Roman",Times,serif; }
      main { padding:0; max-width:none; }
      nav, .skip-link, footer { display:none; }
      section { margin-top:14pt; }
      h1 { font-size:22pt; }
      h2 { font-size:12pt; }
      h3 { font-size:11pt; }
      h2, h3 { break-after:avoid; }
      .project, .entry { break-inside:avoid; margin-bottom:10pt; }
      a { color:inherit; }
    }
  </style>
</head>
<body>
<a class="skip-link" href="#selected-projects">Skip to selected projects</a>
<main>
  {% set c = resume.personal.contact %}
  <header>
    <div class="identity">
      {% for cert in resume.certifications if cert.badge_url and cert.credly_url %}
      <a class="badge" href="{{ cert.credly_url }}" aria-label="UC Davis Python data-analysis certification"><img src="{{ cert.badge_url }}" alt="UC Davis Python data-analysis certification" width="52" height="52"></a>
      {% endfor %}
      <div>
        <h1>{{ resume.personal.name }}</h1>
        <p class="focus">{{ resume.personal.headline }}</p>
        <p class="meta">{{ resume.personal.supporting_line }}</p>
      </div>
    </div>
    <p>{{ resume.site.intro_blurb | trim }}</p>
    <nav aria-label="Contact and documents">
      <a href="{{ engineering_pdf_url | default('marco_del_fava_engineering.pdf') }}" download>Engineering résumé · 1 page</a>
      <a href="{{ pdf_url }}" download>Full research CV (PDF)</a>
      {% if c.github %}<a href="{{ c.github }}">GitHub</a>{% endif %}
      {% if c.linkedin %}<a href="{{ c.linkedin }}">LinkedIn</a>{% endif %}
      <a href="mailto:{{ c.email }}">Email</a>
    </nav>
  </header>

  {% if resume.research %}
  <section aria-labelledby="research-title">
    <h2 id="research-title">Research Experience</h2>
    {% for job in resume.research %}{{ entry(job) }}{% endfor %}
  </section>
  {% endif %}

  <section id="selected-projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Selected Engineering Projects</h2>
    {% for project in resume.projects %}
    <article class="project" id="{{ project.id }}">
      <h3>{{ project.name }}</h3>
      <p>{{ project.problem }}</p>
      <p>{% for bullet in project.bullets %}{{ bullet.text }}{% if not loop.last %} {% endif %}{% endfor %}</p>
      {% if project.tools %}<p class="meta">{{ project.tools }}</p>{% endif %}
      {% if project.links %}<a href="{{ project.links[0].url | replace('https://barkbarkbarkbarkbarkbarkbark.github.io/resumes_and_letters/', '') }}">{{ project.links[0].label }}</a>{% endif %}
    </article>
    {% endfor %}
  </section>

  <section class="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">Technical Skills &amp; Engineering Practices</h2>
    {% for group in resume.skills %}
    <p><strong>{{ group.category }}:</strong> {% for item in group['items'] %}{{ item.text }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
    {% endfor %}
  </section>

  <section aria-labelledby="professional-title">
    <h2 id="professional-title">Additional Professional Experience</h2>
    {% for job in resume.experience + resume.volunteer %}{{ entry(job) }}{% endfor %}
  </section>

  <section aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    {% for edu in resume.education %}
    <p><strong>{{ edu.degree }}</strong><br>{{ edu.institution }} · {{ edu.graduation_date }}</p>
    {% endfor %}
  </section>
  {% if resume.professional_development or resume.certifications %}
  <section aria-labelledby="certifications-title">
    <h2 id="certifications-title">Professional Development &amp; Certifications</h2>
    {% for course in resume.professional_development %}
    <p><strong>{{ course.name }}</strong><br>{{ course.institution }} · {{ course.year }}</p>
    {% endfor %}
    {% if resume.certifications %}
    <ul>{% for cert in resume.certifications %}<li>{% if cert.credly_url %}<a href="{{ cert.credly_url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %} — {{ cert.issuer }}</li>{% endfor %}</ul>
    {% endif %}
  </section>
  {% endif %}
  <footer><a href="evidence.html">Technical evidence: methods, measurements, and source references</a>{% if source_commit %}<br>Source revision: {{ source_commit }}{% endif %}</footer>
</main>
</body>
</html>
